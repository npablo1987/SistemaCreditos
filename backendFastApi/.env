PROJECT_NAME=Sistema de Prestamos API
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change-me-super-secret
REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=sistema_creditos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@sistemacreditos.local
SMTP_FROM_NAME=Sistema Creditos
SMTP_TLS=false
EMAILS_ENABLED=false
